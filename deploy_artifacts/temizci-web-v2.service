[Unit]
Description=Temizci Burada v2 Next.js Web
After=network.target

[Service]
Type=simple
User=piksel
Group=www-data
WorkingDirectory=/var/www/html/Temizlik_Burda_v2/web
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 3001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
